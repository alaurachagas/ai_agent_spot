{
  "mapping_sequence": {
    "description": "Rotate, walk forward to map corridor, then reorient.",
    "steps": [
      {
        "tool": "turn_robot",
        "args": {
          "angle_deg": 90
        }
      },
      {
        "tool": "walk_forward_robot",
        "args": {
          "distance_m": 4.0
        }
      },
      {
        "tool": "turn_robot",
        "args": {
          "angle_deg": -45
        }
      }
    ]
  },

  "inspection_sequence": {
    "description": "Example of another sequence.",
    "steps": [
      {
        "tool": "turn_robot",
        "args": { "angle_deg": 180 }
      },
      {
        "tool": "walk_forward_robot",
        "args": {
          "distance_m": 4.0
        }
      },
      {
        "tool": "turn_robot",
        "args": { "angle_deg": 180 }
      }
    ]
  },
  "inspect_ros_pipeline": {
    "description": "Inspect which ROS topics and nodes are active.",
    "steps": [
      {
        "tool": "ros2_topic_list",
        "args": {}
      },
      {
        "tool": "ros2_node_list",
        "args": {}  
      }
    ]
  }
}
